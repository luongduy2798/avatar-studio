AVATAR_MASTER_URL=wss://avatar.example.com/runner/ws
AVATAR_RUNNER_NAME=
AVATAR_RUNNER_ENROLL_CODE=
AVATAR_RUNNER_CREDENTIALS=$HOME/.avatar-runner/credentials.json
AVATAR_RUNNER_RUNTIME_ROOT=$HOME/.avatar-runner/.runtime
AVATAR_RUNTIME_ROOT=$HOME/.avatar-runner/.runtime
AVATAR_RUNTIME_CODE_ROOT=$HOME/.avatar-runner/runner/runtime
LIVEPORTRAIT_ROOT=$HOME/.cache/avatar-studio/LivePortrait
LIVEPORTRAIT_PYTHON=$HOME/.cache/avatar-studio/LivePortrait/.venv/bin/python
AVATAR_PIPELINE_MODE=staged
AVATAR_MAX_INFLIGHT_JOBS=3
AVATAR_MAX_DECODE_BATCH=3
AVATAR_DECODE_BATCH_WAIT_MS=25
AVATAR_DECODE_BATCH_SIZE=24
AVATAR_ONNX_DEVICE=cpu
AVATAR_ONNX_THREADS=16
