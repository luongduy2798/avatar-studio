AVATAR_INFRA_MODE=local
AVATAR_LOCAL_BENCHMARKS=1
AVATAR_RUNTIME_ROOT=.runtime
AVATAR_PIPELINE_MODE=staged
LIVEPORTRAIT_ROOT=~/.cache/avatar-studio/LivePortrait
LIVEPORTRAIT_PYTHON=~/.cache/avatar-studio/LivePortrait/.venv/bin/python
AVATAR_WORKER_MAX_ATTEMPTS=3
AVATAR_VISIBILITY_TIMEOUT_SECONDS=900
AVATAR_PREPROCESS_WORKERS=2
AVATAR_EXPORT_WORKERS=2
AVATAR_PREPROCESS_QUEUE_SIZE=6
AVATAR_DECODE_QUEUE_SIZE=6
AVATAR_MAX_DECODE_BATCH=3
AVATAR_DECODE_BATCH_WAIT_MS=25
# Deprecated compatibility alias for AVATAR_MAX_DECODE_BATCH.
# AVATAR_JOB_BATCH_SIZE=3
# Deprecated compatibility alias for AVATAR_DECODE_BATCH_WAIT_MS.
# AVATAR_JOB_BATCH_WAIT_MS=25
AVATAR_ONNX_DEVICE=cpu
# Optional per-stage override, e.g. cuda for matte on an NVIDIA host.
# AVATAR_ONNX_MATTE_DEVICE=cuda
AVATAR_ONNX_THREADS=16
AVATAR_DECODE_BATCH_SIZE=24
AWS_REGION=ap-southeast-1
AVATAR_S3_BUCKET=
AVATAR_SQS_QUEUE_URL=
AVATAR_DYNAMODB_JOBS_TABLE=
AVATAR_DYNAMODB_RUNNERS_TABLE=
AVATAR_DYNAMODB_ENROLLMENTS_TABLE=
AVATAR_DYNAMODB_IDEMPOTENCY_TABLE=
AVATAR_SQS_DLQ_URL=
